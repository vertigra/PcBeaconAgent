    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PcBeaconAgent.Client.Core</AssemblyName>
    <RootNamespace>PcBeaconAgent.Client.Core</RootNamespace>
