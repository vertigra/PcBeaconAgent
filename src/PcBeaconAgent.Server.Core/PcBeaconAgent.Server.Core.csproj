<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PcBeaconAgent.Server.Core</AssemblyName>
    <RootNamespace>PcBeaconAgent.Server.Core</RootNamespace>
    <NoWarn>$(NoWarn);IL2026;NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PcBeaconAgent.Server.Core.Tests" />
    <!-- Moq uses Castle DynamicProxy to mock ILogger&lt;T&gt; where T is
         internal. Without this, Moq throws ArgumentException at
         proxy creation time. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2, " />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AudioSwitcher.AudioApi.CoreAudio" Version="3.0.3" />
    <!-- Wrapper over the Windows CCD API (SetDisplayConfig).
         LGPL license — allows use in MIT/closed-source projects, but
         technically requires shipping a README noting the library's license. -->
    <PackageReference Include="WindowsDisplayAPI" Version="1.3.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PcBeaconAgent.Contracts\PcBeaconAgent.Contracts.csproj" />
  </ItemGroup>

</Project>