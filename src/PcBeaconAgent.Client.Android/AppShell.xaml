<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="PcBeaconAgent.Client.Android.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:PcBeaconAgent.Client.Android.Pages"
       Title="BeaconClient">

    <TabBar>
        <ShellContent Title="Devices"
                      ContentTemplate="{DataTemplate local:MainPage}"
                      Route="MainPage"/>

        
        <ShellContent Title="Discovery"
                      ContentTemplate="{DataTemplate local:DiscoveryPage}"
                      Route="DiscoveryPage"/>

        <ShellContent Title="Settings"
                      ContentTemplate="{DataTemplate local:SettingsPage}"
                      Route="SettingsPage"/>
    </TabBar>

    <!-- Non-tab routes — pushed onto the navigation stack.
         SendTextPage / SendFilePage reached from MainPage's buttons.
         ShareTextPage / ShareFilePage reached from the Android Share
         Sheet (text/plain and */* intent filters respectively). -->
    <ShellContent Route="SendTextPage"
                  ContentTemplate="{DataTemplate local:SendTextPage}"/>

    <ShellContent Route="SendFilePage"
                  ContentTemplate="{DataTemplate local:SendFilePage}"/>

    <ShellContent Route="ShareTextPage"
                  ContentTemplate="{DataTemplate local:ShareTextPage}"
                  Shell.PresentationMode="ModalAnimated"/>

    <ShellContent Route="ShareFilePage"
                  ContentTemplate="{DataTemplate local:ShareFilePage}"
                  Shell.PresentationMode="ModalAnimated"/>

</Shell>