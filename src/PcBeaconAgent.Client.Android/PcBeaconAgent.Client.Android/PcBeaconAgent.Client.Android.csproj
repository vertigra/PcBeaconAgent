<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>

    <EnableDefaultMauiItems>true</EnableDefaultMauiItems>
    <AndroidUseLatestPlatformSdk>true</AndroidUseLatestPlatformSdk>

    <AssemblyName>PcBeaconAgent.Client.Android</AssemblyName>
    <RootNamespace>PcBeaconAgent.Client.Android</RootNamespace>
    <ApplicationTitle>BeaconClient</ApplicationTitle>
    <ApplicationId>com.companyname.beaconclient</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationVersionDisplay>1.0</ApplicationVersionDisplay>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
    <PackageReference Include="CommunityToolkit.Maui" Version="14.2.0" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.70" />
    <PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.70" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\PcBeaconAgent.Client.Core\PcBeaconAgent.Client.Core.csproj" />
  </ItemGroup>

</Project>