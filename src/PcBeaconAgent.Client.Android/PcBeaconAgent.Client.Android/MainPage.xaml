<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PcBeaconAgent.Client.Android.ViewModels"
             xmlns:models="clr-namespace:PcBeaconAgent.Client.Core.Models;assembly=PcBeaconAgent.Client.Core"
             xmlns:conv="clr-namespace:PcBeaconAgent.Client.Android.Converters"
             x:Class="PcBeaconAgent.Client.Android.MainPage"
             x:DataType="vm:MainViewModel"
             BackgroundColor="#121212">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <conv:BoolToColorConverter x:Key="BoolToColorConverter" />
            <conv:BoolToTextConverter x:Key="BoolToTextConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, Auto, *, Auto, *" Padding="20" RowSpacing="10">

        <Button Grid.Row="0" Text="Start Scan" 
                Command="{Binding StartScanCommand}" 
                IsEnabled="{Binding IsScanning, Converter={StaticResource InvertedBoolConverter}}"
                BackgroundColor="#6750A4" CornerRadius="12" />

        <Label Grid.Row="1" Text="Discovered Devices" FontAttributes="Bold" TextColor="#D0BCFF" Margin="0,10,0,0"/>

        <CollectionView Grid.Row="2" ItemsSource="{Binding DiscoveredDevices}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:BeaconDevice">
                    <Border StrokeShape="RoundRectangle 12" BackgroundColor="#212121" Margin="0,5" Padding="15">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding IpAddress, StringFormat='IP: {0}'}" FontSize="12" TextColor="#BDBDBD"/>
                            </VerticalStackLayout>

                            <Button Grid.Column="1" Text="Remember" 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=RememberCommand}" 
                                    CommandParameter="{Binding .}" 
                                    BackgroundColor="#4CAF50" TextColor="White"
                                    HeightRequest="40" WidthRequest="110" CornerRadius="8" VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="3" Text="Managed Devices" FontAttributes="Bold" TextColor="#D0BCFF" Margin="0,10,0,0"/>

        <CollectionView Grid.Row="4" ItemsSource="{Binding ManagedDevices}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ManagedDevice">
                    <Border StrokeShape="RoundRectangle 12" BackgroundColor="#322F35" Margin="0,5" Padding="15">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding Device.MachineName, TargetNullValue='Unknown'}" FontAttributes="Bold" FontSize="16" TextColor="White"/>
                                <Label Text="{Binding Device.IpAddress, StringFormat='IP: {0}'}" FontSize="12" TextColor="#BDBDBD"/>
                                <Label Text="{Binding Device.MacAddress, StringFormat='MAC: {0}'}" FontSize="12" TextColor="#BDBDBD"/>
                                <Label Text="{Binding Device.InterfaceName, StringFormat='Interface name: {0}'}" FontSize="12" TextColor="#BDBDBD"/>
                                <Label Text="{Binding Device.InterfaceType, StringFormat='Interface type: {0}'}" FontSize="12" TextColor="#BDBDBD"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="5" HorizontalOptions="Center">
                                    <Ellipse WidthRequest="10" HeightRequest="10" 
                                             Fill="{Binding IsOnline, Converter={StaticResource BoolToColorConverter}}" 
                                             VerticalOptions="Center"/>

                                    <Label Text="{Binding IsOnline, Converter={StaticResource BoolToTextConverter}}" 
                                           FontSize="10" 
                                           TextColor="#BDBDBD" 
                                           VerticalOptions="Center"/>

                                </HorizontalStackLayout>

                                <Button Text="Forget" 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=ForgetCommand}" 
                                        CommandParameter="{Binding .}" 
                                        BackgroundColor="#B3261E" TextColor="White"
                                        HeightRequest="40" WidthRequest="110" CornerRadius="8"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>