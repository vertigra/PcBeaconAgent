<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PcBeaconAgent.Client.Android.ViewModels"
             x:Class="PcBeaconAgent.Client.Android.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Settings"
             BackgroundColor="#121212">

    <VerticalStackLayout Padding="24" Spacing="16">

        <Label Text="API Key"
               FontAttributes="Bold"
               TextColor="#D0BCFF"
               FontSize="14"/>

        <Label Text="Copy the key from server.key file on the host machine."
               TextColor="#BDBDBD"
               FontSize="12"/>

        <Entry Placeholder="Paste API key here"
               Text="{Binding ApiKey}"
               PlaceholderColor="#757575"
               TextColor="White"
               BackgroundColor="#212121"
               IsPassword="False"/>

        <HorizontalStackLayout Spacing="12">
            <Button Text="Save"
                    Command="{Binding SaveCommand}"
                    BackgroundColor="#6750A4"
                    TextColor="White"
                    CornerRadius="8"
                    HorizontalOptions="Fill"
                    WidthRequest="140"/>

            <Button Text="Clear"
                    Command="{Binding ClearCommand}"
                    BackgroundColor="#B3261E"
                    TextColor="White"
                    CornerRadius="8"
                    WidthRequest="100"/>
        </HorizontalStackLayout>

        <Label Text="{Binding StatusMessage}"
               TextColor="#4CAF50"
               FontSize="13"
               IsVisible="{Binding StatusMessage, Converter={x:Static x:String.IsNullOrEmpty}}"
               HorizontalOptions="Center"/>

    </VerticalStackLayout>
</ContentPage>