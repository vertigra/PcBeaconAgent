<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PcBeaconAgent.Client.Android.ViewModels"
             xmlns:conv="clr-namespace:PcBeaconAgent.Client.Android.Converters"
             x:Class="PcBeaconAgent.Client.Android.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Settings"
             BackgroundColor="#121212">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
            <conv:StringIsEmptyConverter x:Key="StringIsEmptyConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label Text="Manual API Key (fallback)"
                   FontAttributes="Bold"
                   TextColor="#D0BCFF"
                   FontSize="14"/>

            <Label Text="Used only if a device has no key of its own."
                   TextColor="#BDBDBD"
                   FontSize="12"/>

            <Entry Placeholder="Paste API key here"
                   Text="{Binding ApiKey}"
                   PlaceholderColor="#757575"
                   TextColor="White"
                   BackgroundColor="#212121"/>

            <HorizontalStackLayout Spacing="12">
                <Button Text="Save" Command="{Binding SaveCommand}"
                        BackgroundColor="#6750A4" TextColor="White"
                        CornerRadius="8" WidthRequest="140"/>
                <Button Text="Clear" Command="{Binding ClearCommand}"
                        BackgroundColor="#B3261E" TextColor="White"
                        CornerRadius="8" WidthRequest="100"/>
            </HorizontalStackLayout>

            <Label Text="{Binding StatusMessage}"
                   TextColor="#4CAF50" FontSize="13"
                   HorizontalOptions="Center"/>

            <BoxView HeightRequest="1" BackgroundColor="#2C2C2C" Margin="0,10"/>

            <!-- FIX (новая секция): полный список всех когда-либо сохранённых
                 ключей, а не только глобальный. -->
            <Label Text="Stored Keys"
                   FontAttributes="Bold"
                   TextColor="#D0BCFF"
                   FontSize="14"/>

            <Label Text="One key per paired server, plus the manual fallback above."
                   TextColor="#BDBDBD"
                   FontSize="12"/>

            <CollectionView ItemsSource="{Binding StoredKeys}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:StoredKeyEntry">
                        <Border StrokeShape="RoundRectangle 10"
                                BackgroundColor="#212121"
                                Margin="0,4" Padding="12">
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">

                                    <!-- FIX: если MachineName известен — показываем его как
                                                основной заголовок, а IP уходит во вторую строку.
                                                Для "global" или незапомненного устройства (MachineName
                                                == null) заголовком остаётся сам Identifier, как раньше. -->
                                    <Label Text="{Binding MachineName, TargetNullValue=''}"
                                           FontAttributes="Bold"
                                           TextColor="White" FontSize="14"
                                           IsVisible="{Binding MachineName, Converter={StaticResource StringNotEmptyConverter}}"/>

                                    <Label Text="{Binding Identifier}"
                                           FontAttributes="Bold"
                                           TextColor="White" FontSize="14"
                                           IsVisible="{Binding MachineName, Converter={StaticResource StringIsEmptyConverter}}"/>

                                    <Label Text="{Binding Identifier, StringFormat='IP: {0}'}"
                                           TextColor="#9E9E9E" FontSize="11"
                                           IsVisible="{Binding MachineName, Converter={StaticResource StringNotEmptyConverter}}"/>

                                    <Label Text="{Binding MacAddress, StringFormat='MAC: {0}'}"
                                           TextColor="#9E9E9E" FontSize="11"
                                           IsVisible="{Binding MacAddress, Converter={StaticResource StringNotEmptyConverter}}"/>

                                    <Label Text="{Binding Value}"
                                           TextColor="#757575" FontSize="11"
                                           LineBreakMode="TailTruncation"/>
                                    
                                </VerticalStackLayout>

                                <Button Grid.Column="1"
                                        Text="Remove"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=RemoveStoredKeyCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#B3261E" TextColor="White"
                                        FontSize="12" CornerRadius="6"
                                        WidthRequest="90" HeightRequest="36"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <Label Text="No keys stored yet."
                           TextColor="#757575"
                           HorizontalOptions="Center"
                           Margin="0,12"/>
                </CollectionView.EmptyView>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>