<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PcBeaconAgent.Client.Android.ViewModels"
             xmlns:clientModels="clr-namespace:PcBeaconAgent.Client.Core.Models;assembly=PcBeaconAgent.Client.Core"
             xmlns:conv="clr-namespace:PcBeaconAgent.Client.Android.Converters"
             x:Class="PcBeaconAgent.Client.Android.Pages.MainPage"
             x:DataType="vm:MainViewModel"
             BackgroundColor="#121212">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:BoolToColorConverter x:Key="BoolToColorConverter" />
            <conv:BoolToTextConverter x:Key="BoolToTextConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *" Padding="20" RowSpacing="10">

        <Label Grid.Row="0" Text="Managed Devices" FontAttributes="Bold" TextColor="#D0BCFF" Margin="0,10,0,0"/>

        <CollectionView Grid.Row="1" ItemsSource="{Binding ManagedDevices}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="clientModels:ManagedDevice">
                    <Border StrokeShape="RoundRectangle 12" BackgroundColor="#322F35" Margin="0,5" Padding="15">
                        <Grid RowDefinitions="Auto, Auto, Auto" RowSpacing="10">

                            <!-- Row 0: Machine name + status -->
                            <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0"
                                       Text="{Binding Device.MachineName, TargetNullValue='Unknown'}"
                                       FontAttributes="Bold" FontSize="16" TextColor="White"/>
                                <HorizontalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                    <Ellipse WidthRequest="10" HeightRequest="10"
                                             Fill="{Binding IsOnline, Converter={StaticResource BoolToColorConverter}}"/>
                                    <Label Text="{Binding IsOnline, Converter={StaticResource BoolToTextConverter}}"
                                           FontSize="10" TextColor="#BDBDBD" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Grid>

                            <!-- Row 1: Device info -->
                            <VerticalStackLayout Grid.Row="1" Spacing="2">
                                <Label Text="{Binding Device.IpAddress, StringFormat='IP: {0}'}" FontSize="12" TextColor="#BDBDBD"/>
                                <Label Text="{Binding Device.MacAddress, StringFormat='MAC: {0}'}" FontSize="12" TextColor="#BDBDBD"/>
                                <Label Text="{Binding Device.InterfaceName, StringFormat='Interface name: {0}'}" FontSize="12" TextColor="#BDBDBD"/>
                                <Label Text="{Binding Device.InterfaceType, StringFormat='Interface type: {0}'}" FontSize="12" TextColor="#BDBDBD"/>
                            </VerticalStackLayout>

                            <!-- Row 2: Action buttons (icons) -->
                            <Grid Grid.Row="2" ColumnDefinitions="*, *, *, Auto" ColumnSpacing="10" Margin="0,5,0,0">
                                <Button Grid.Column="0" Text="🔊"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=ManageAudioCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#6750A4" TextColor="White"
                                        HeightRequest="44" CornerRadius="8"
                                        FontSize="20" Padding="0"/>
                                <Button Grid.Column="1" Text="🖥️"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=ManageDisplayCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#6750A4" TextColor="White"
                                        HeightRequest="44" CornerRadius="8"
                                        FontSize="20" Padding="0"/>
                                <Button Grid.Column="3" Text="🗑️"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=ForgetCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#B3261E" TextColor="White"
                                        HeightRequest="44" WidthRequest="60" CornerRadius="8"
                                        FontSize="18" Padding="0"/>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>