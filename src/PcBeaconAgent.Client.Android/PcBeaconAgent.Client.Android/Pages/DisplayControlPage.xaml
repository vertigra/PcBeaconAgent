<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PcBeaconAgent.Client.Android.ViewModels"
             xmlns:conv="clr-namespace:PcBeaconAgent.Client.Android.Converters"
             x:Class="PcBeaconAgent.Client.Android.Pages.DisplayControlPage"
             x:DataType="vm:DisplayControlViewModel"
             Title="Displays"
             BackgroundColor="#121212">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, Auto, Auto, *" Padding="20" RowSpacing="12">

        <Label Grid.Row="0" FontSize="16" FontAttributes="Bold" TextColor="White">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="Device: " TextColor="#BDBDBD"/>
                    <Span Text="{Binding MachineName}" TextColor="#D0BCFF"/>
                </FormattedString>
            </Label.FormattedText>
        </Label>

        <Button Grid.Row="1"
                Text="Refresh"
                Command="{Binding RefreshCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                BackgroundColor="#6750A4" TextColor="White"
                CornerRadius="10" HeightRequest="44"/>

        <Button Grid.Row="2"
                Text="Restore All"
                Command="{Binding RestoreAllCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                BackgroundColor="#4CAF50" TextColor="White"
                CornerRadius="10" HeightRequest="44"/>

        <Label Grid.Row="3"
               Text="{Binding ErrorMessage}"
               TextColor="#F44336" FontSize="13"
               HorizontalOptions="Center" VerticalOptions="Start"
               IsVisible="{Binding HasError}"/>

        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding Displays}"
                        IsVisible="{Binding HasError, Converter={StaticResource InvertedBoolConverter}}">
            <CollectionView.EmptyView>
                <Label Text="No displays found."
                       TextColor="#757575" HorizontalOptions="Center" Margin="0,20"/>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:DisplayDeviceItem">
                    <Border StrokeShape="RoundRectangle 12"
                            BackgroundColor="#212121" Margin="0,5" Padding="15">
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding FriendlyName}" FontSize="15" TextColor="White"/>
                                <Label Text="Active" FontSize="11" TextColor="#4CAF50"
                                       IsVisible="{Binding IsActive}"/>
                                <Label Text="Disabled" FontSize="11" TextColor="#757575"
                                       IsVisible="{Binding IsActive, Converter={StaticResource InvertedBoolConverter}}"/>
                            </VerticalStackLayout>

                            <Button Grid.Column="1"
                                    Text="Disable"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DisplayControlViewModel}}, Path=DisableCommand}"
                                    CommandParameter="{Binding .}"
                                    IsVisible="{Binding IsActive}"
                                    BackgroundColor="#B3261E" TextColor="White"
                                    FontSize="12" CornerRadius="8"
                                    WidthRequest="100" HeightRequest="38"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>