<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PcBeaconAgent.Client.Android.ViewModels"
             xmlns:conv="clr-namespace:PcBeaconAgent.Client.Android.Converters"
             x:Class="PcBeaconAgent.Client.Android.Pages.DisplayControlPage"
             x:DataType="vm:DisplayControlViewModel"
             Title="Displays"
             BackgroundColor="#121212">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, Auto, Auto, Auto, *, Auto" Padding="20" RowSpacing="12">

        <Label Grid.Row="0" FontSize="16" FontAttributes="Bold" TextColor="White">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="Device: " TextColor="#BDBDBD"/>
                    <Span Text="{Binding MachineName}" TextColor="#D0BCFF"/>
                </FormattedString>
            </Label.FormattedText>
        </Label>

        <HorizontalStackLayout Grid.Row="1"
                               Spacing="8"
                               IsVisible="{Binding HasTopology}">
            <!-- Topology icon: two monitor rectangles whose layout
                 reflects the active topology. Extend → side-by-side;
                 Clone → second monitor overlaps the first; Internal →
                 second monitor faded; External → first monitor faded.
                 The exact topology name is still shown as text next to
                 the icon so there is no ambiguity (e.g. for
                 accessibility / screen readers). -->
            <Grid WidthRequest="34" HeightRequest="20" VerticalOptions="Center">
                <!-- Monitor 1 (left). Faded only for External. -->
                <Border WidthRequest="16" HeightRequest="13"
                        StrokeShape="RoundRectangle 2"
                        BackgroundColor="#D0BCFF"
                        StrokeThickness="0"
                        HorizontalOptions="Start"
                        VerticalOptions="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Opacity" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding TopologyKind}" Value="External">
                                    <Setter Property="Opacity" Value="0.3"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <!-- Monitor 2 (right). Overlaps for Clone, faded for
                     Internal. -->
                <Border WidthRequest="16" HeightRequest="13"
                        StrokeShape="RoundRectangle 2"
                        BackgroundColor="#D0BCFF"
                        StrokeThickness="0"
                        HorizontalOptions="End"
                        VerticalOptions="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Opacity" Value="1"/>
                            <Setter Property="TranslationX" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding TopologyKind}" Value="Clone">
                                    <Setter Property="TranslationX" Value="-6"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding TopologyKind}" Value="Internal">
                                    <Setter Property="Opacity" Value="0.3"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
            <Label Text="{Binding CurrentTopology, StringFormat='Topology: {0}'}"
                   FontSize="13" TextColor="#9E9E9E"
                   VerticalOptions="Center"/>
        </HorizontalStackLayout>

        <Button Grid.Row="2"
                Text="Refresh"
                Command="{Binding RefreshCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                BackgroundColor="#6750A4" TextColor="White"
                CornerRadius="10" HeightRequest="44"/>

        <Button Grid.Row="3"
                Text="Restore All"
                Command="{Binding RestoreAllCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                BackgroundColor="#4CAF50" TextColor="White"
                CornerRadius="10" HeightRequest="44"/>

        <Label Grid.Row="4"
               Text="{Binding ErrorMessage}"
               TextColor="#F44336" FontSize="13"
               HorizontalOptions="Center" VerticalOptions="Start"
               IsVisible="{Binding HasError}"/>

        <CollectionView Grid.Row="4"
                        ItemsSource="{Binding Displays}"
                        IsVisible="{Binding HasError, Converter={StaticResource InvertedBoolConverter}}">
            <CollectionView.EmptyView>
                <Label Text="No displays found."
                       TextColor="#757575" HorizontalOptions="Center" Margin="0,20"/>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:DisplayInfo">
                    <Border StrokeShape="RoundRectangle 12"
                            BackgroundColor="#212121" Margin="0,5" Padding="15">
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding FriendlyName}" FontSize="15" TextColor="White"/>
                                    <Label Text="★ Primary" FontSize="11" TextColor="#FFD700" FontAttributes="Bold"
                                           IsVisible="{Binding IsPrimary}"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                                <Label Text="Active" FontSize="11" TextColor="#4CAF50"
                                       IsVisible="{Binding IsActive}"/>
                                <Label Text="Disabled" FontSize="11" TextColor="#757575"
                                       IsVisible="{Binding IsActive, Converter={StaticResource InvertedBoolConverter}}"/>
                                <Label Text="Last active display — cannot disable"
                                       FontSize="11" TextColor="#FF9800"
                                       IsVisible="{Binding IsLastActive}"/>
                            </VerticalStackLayout>

                            <Button Grid.Column="1"
                                    Text="Disable"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DisplayControlViewModel}}, Path=DisableCommand}"
                                    CommandParameter="{Binding .}"
                                    IsVisible="{Binding IsActive}"
                                    IsEnabled="{Binding IsLastActive, Converter={StaticResource InvertedBoolConverter}}"
                                    BackgroundColor="#B3261E" TextColor="White"
                                    FontSize="12" CornerRadius="8"
                                    WidthRequest="100" HeightRequest="38"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="5"
               Text="Note: An “Active” display is connected to the GPU but may be physically powered off. Windows reports it as active until the cable is disconnected."
               FontSize="10" TextColor="#666666"
               HorizontalOptions="Fill" Margin="0,8,0,0"/>

    </Grid>
</ContentPage>