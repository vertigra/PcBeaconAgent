<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PcBeaconAgent.Client.Android.ViewModels"
             xmlns:conv="clr-namespace:PcBeaconAgent.Client.Android.Converters"
             x:Class="PcBeaconAgent.Client.Android.Pages.SendTextPage"
             x:DataType="vm:SendTextViewModel"
             Title="Send Text"
             BackgroundColor="#121212">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *, Auto, Auto" Padding="20" RowSpacing="12">

        <!-- Header: target device -->
        <Border Grid.Row="0"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="#2A2A2A"
                Padding="14,10">
            <Grid ColumnDefinitions="Auto, *">
                <Label Grid.Column="0"
                       Text="To:"
                       FontSize="13"
                       TextColor="#9E9E9E"
                       VerticalOptions="Center"
                       Margin="0,0,8,0"/>
                <Label Grid.Column="1"
                       Text="{Binding MachineName, TargetNullValue='Unknown'}"
                       FontSize="15" FontAttributes="Bold"
                       TextColor="#D0BCFF"
                       VerticalOptions="Center"/>
            </Grid>
        </Border>

        <!-- Editor: multiline text input -->
        <Border Grid.Row="1"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="#2A2A2A"
                Stroke="#3A3A3A"
                StrokeThickness="1"
                Padding="2">
            <Editor Text="{Binding Text, Mode=TwoWay}"
                    Placeholder="Type or paste text to send…"
                    PlaceholderColor="#6E6E6E"
                    TextColor="White"
                    BackgroundColor="#2A2A2A"
                    FontSize="15"
                    AutoSize="TextChanges"
                    Keyboard="Chat"/>
        </Border>

        <!-- Status line -->
        <Label Grid.Row="2"
               Text="{Binding StatusMessage}"
               FontSize="12"
               TextColor="#F44336"
               IsVisible="{Binding HasError}"/>

        <!-- Action buttons -->
        <Grid Grid.Row="3" ColumnDefinitions="*, *" ColumnSpacing="10">
            <Button Grid.Column="0"
                    Text="Paste"
                    Command="{Binding PasteFromClipboardCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    BackgroundColor="#424242" TextColor="White"
                    CornerRadius="10" HeightRequest="48"/>
            <Button Grid.Column="1"
                    Text="Send"
                    Command="{Binding SendCommand}"
                    IsEnabled="{Binding CanSend}"
                    BackgroundColor="#6750A4" TextColor="White"
                    CornerRadius="10" HeightRequest="48"
                    FontAttributes="Bold"/>
        </Grid>
    </Grid>
</ContentPage>
