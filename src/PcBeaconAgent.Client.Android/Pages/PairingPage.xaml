<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PcBeaconAgent.Client.Android.ViewModels"
             xmlns:conv="clr-namespace:PcBeaconAgent.Client.Android.Converters"
             x:Class="PcBeaconAgent.Client.Android.Pages.PairingPage"
             x:DataType="vm:PairingViewModel"
             Title="Pair Device"
             BackgroundColor="#121212">
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <VerticalStackLayout Padding="28" Spacing="20" VerticalOptions="Center">

        <VerticalStackLayout Spacing="4">
            <Label Text="Server found:" TextColor="#BDBDBD" FontSize="13"/>
            <Label FontSize="16" FontAttributes="Bold" TextColor="White">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding ServerIp}" TextColor="#D0BCFF"/>
                        <Span Text=":" TextColor="#BDBDBD"/>
                        <Span Text="{Binding ServerPort}" TextColor="#D0BCFF"/>
                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </VerticalStackLayout>

        <BoxView HeightRequest="1" BackgroundColor="#2C2C2C"/>

        <Label TextColor="#BDBDBD" FontSize="14" LineBreakMode="WordWrap">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="A popup with the" TextColor="#BDBDBD"/>
                    <Span Text=" PAIRING PIN" TextColor="#D0BCFF" FontAttributes="Bold"/>
                    <Span Text=" has appeared next to the system tray on the server. Enter the 6-digit code below." TextColor="#BDBDBD"/>
                </FormattedString>
            </Label.FormattedText>
        </Label>

        <Entry Placeholder="● ● ● ● ● ●"
               Text="{Binding Pin}"
               Keyboard="Numeric"
               MaxLength="6"
               FontSize="32"
               HorizontalTextAlignment="Center"
               CharacterSpacing="12"
               PlaceholderColor="#424242"
               TextColor="White"
               BackgroundColor="#1E1E1E"/>

        <Label Text="{Binding ErrorMessage}"
               TextColor="#F44336"
               FontSize="13"
               HorizontalOptions="Center"
               IsVisible="{Binding HasError}"/>

        <Button Text="Pair"
                Command="{Binding PairCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                BackgroundColor="#6750A4"
                TextColor="White"
                CornerRadius="12"
                HeightRequest="52"
                FontSize="16"/>

        <Button Text="Regenerate PIN on server"
                Command="{Binding RegeneratePinCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                BackgroundColor="Transparent"
                TextColor="#BDBDBD"
                FontSize="13"
                BorderWidth="0"/>

    </VerticalStackLayout>

</ContentPage>