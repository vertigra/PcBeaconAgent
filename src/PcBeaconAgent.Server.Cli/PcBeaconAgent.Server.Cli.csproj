<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <AssemblyName>PcBeaconAgent.Server.Cli</AssemblyName>
    <RootNamespace>PcBeaconAgent.Server.Cli</RootNamespace>
    <UserSecretsId>dotnet-PcBeaconAgent-cfec9708-b427-4f85-9e98-3cf8c1748e58</UserSecretsId>
    <NoWarn>$(NoWarn);NU1701;NETSDK1128;IL2026;IL2104</NoWarn>
    <!-- NU1903: Microsoft.AspNetCore.OpenApi 10.0.9 transitively pulls
         Microsoft.OpenApi 2.0.0 which has GHSA-v5pm-xwqc-g5wc (high).
         10.0.10+ does not exist yet on NuGet as of 2026-07. The advisory
         affects OpenApiReader parsing of untrusted OpenAPI documents —
         our usage is generate-only (AddOpenApi / MapOpenApi), we never
         feed the library untrusted input, so the practical risk is nil.
         Re-evaluate when a fixed Microsoft.AspNetCore.OpenApi ships. -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>

    <ApplicationIcon>beacon.ico</ApplicationIcon>

    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfContained>true</IncludeNativeLibrariesForSelfContained>

    <Version Condition="'$(AppVersionName)' == ''">1.0.0</Version>
    <Version Condition="'$(AppVersionName)' != ''">$(AppVersionName)</Version>

    <AssemblyVersion Condition="'$(AppVersionName)' == ''">1.0.0.0</AssemblyVersion>
    <AssemblyVersion Condition="'$(AppVersionName)' != ''">$(AppVersionName).0</AssemblyVersion>

    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <EnableComHosting>true</EnableComHosting>
  </PropertyGroup>

  <Target Name="RemoveIisFiles" AfterTargets="Publish">
    <Delete Files="$(PublishDir)aspnetcorev2_inprocess.dll" />
    <Delete Files="$(PublishDir)aspnetcorev2_inprocess.so" />
    <Delete Files="$(PublishDir)aspnetcorev2_inprocess.dylib" />
  </Target>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.9" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.8" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PcBeaconAgent.Contracts\PcBeaconAgent.Contracts.csproj" />
    <ProjectReference Include="..\PcBeaconAgent.Server.Core\PcBeaconAgent.Server.Core.csproj" />
  </ItemGroup>


</Project>