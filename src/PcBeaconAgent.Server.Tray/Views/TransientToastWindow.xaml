<Window x:Class="PcBeaconAgent.Server.Tray.Views.TransientToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PcBeaconAgent"
        Width="300" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        ShowActivated="False"
        WindowStartupLocation="Manual">
    <Border Background="#1E1E1E"
            CornerRadius="10"
            BorderBrush="#3A3A3A"
            BorderThickness="1"
            Padding="14,10,14,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Severity accent stripe. Colour is driven by a DataTrigger
                 on the Severity enum so the ViewModel stays free of
                 WPF Media types. -->
            <Rectangle Grid.Column="0"
                       Width="4"
                       Margin="0,2,8,2"
                       HorizontalAlignment="Left">
                <Rectangle.Style>
                    <Style TargetType="Rectangle">
                        <Setter Property="Fill" Value="#D0BCFF"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                <Setter Property="Fill" Value="#FFB74D"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="Error">
                                <Setter Property="Fill" Value="#F2B8B8"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Rectangle.Style>
            </Rectangle>

            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Title}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="White"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Message}"
                           FontSize="11"
                           Foreground="#BDBDBD"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
