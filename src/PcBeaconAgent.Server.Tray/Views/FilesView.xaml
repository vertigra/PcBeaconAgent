<UserControl x:Class="PcBeaconAgent.Server.Tray.Views.FilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:coreModels="clr-namespace:PcBeaconAgent.Server.Core.Models;assembly=PcBeaconAgent.Server.Core"
             xmlns:ext="clr-namespace:PcBeaconAgent.Server.Tray.Extensions"
             Background="#1E1E1E">
    <UserControl.Resources>
        <ext:InvertBoolConverter x:Key="InvertBoolConverter" />

        <!-- DarkTabItem style — same as MainWindow. Duplicated here
             because UserControl does not inherit Window.Resources.
             If a third copy appears, extract to a shared ResourceDictionary. -->
        <Style x:Key="DarkTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="#9E9E9E"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border"
                                Background="#1E1E1E"
                                BorderThickness="0,0,0,3"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#D0BCFF"/>
                                <Setter TargetName="Border" Property="Background" Value="#2A2A2A"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#D0BCFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <TabControl Background="#1E1E1E" BorderThickness="0" Padding="0">

            <!-- ════════════════════════════════════════════════════ -->
            <!-- ── Tab: Send ────────────────────────────────────────── -->
            <!-- ════════════════════════════════════════════════════ -->
            <TabItem Header="Send" Style="{StaticResource DarkTabItem}">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Device picker -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Recipient"
                                   FontSize="13" Foreground="#9E9E9E"
                                   Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding ConnectedDevices, Mode=OneWay}"
                                  SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  IsEnabled="{Binding IsSending, Converter={StaticResource InvertBoolConverter}}"/>
                        <TextBlock Text="No phones connected. Open the app on your phone to connect."
                                   FontSize="11" Foreground="#757575"
                                   Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasConnectedDevices}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Text input -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="Text"
                                   FontSize="13" Foreground="#9E9E9E"
                                   Margin="0,0,0,6"/>
                        <TextBox Text="{Binding OutgoingText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsSending, Converter={StaticResource InvertBoolConverter}}"
                                 Height="100"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="#2A2A2A" Foreground="White"
                                 BorderBrush="#3A3A3A"
                                 ToolTip="Type text to send to the selected phone"/>
                    </StackPanel>

                    <!-- Action buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Send text"
                                Command="{Binding SendTextToPhoneCommand}"
                                Background="#6750A4" Foreground="White"
                                BorderThickness="0"
                                FontSize="12" Padding="14,6"
                                Cursor="Hand"
                                Margin="0,0,8,0"/>
                        <Button Content="📎 Send file"
                                Command="{Binding SendFileToPhoneCommand}"
                                IsEnabled="{Binding IsSending, Converter={StaticResource InvertBoolConverter}}"
                                Background="#424242" Foreground="White"
                                BorderThickness="0"
                                FontSize="12" Padding="14,6"
                                Cursor="Hand"/>
                    </StackPanel>

                    <!-- Send status -->
                    <TextBlock Grid.Row="3"
                               Text="{Binding SendStatus}"
                               FontSize="11" Foreground="#9E9E9E"
                               Margin="0,4,0,0"/>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════ -->
            <!-- ── Tab: Received ────────────────────────────────────── -->
            <!-- ════════════════════════════════════════════════════ -->
            <TabItem Header="Received" Style="{StaticResource DarkTabItem}">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- History list (shown when there are items) -->
                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasHistory}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ItemsControl ItemsSource="{Binding History, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type coreModels:TransferRecord}">
                                    <Border Background="#2A2A2A"
                                            BorderBrush="#3A3A3A"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,0,0,8"
                                            Padding="12,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <Grid>
                                                    <!-- Text variant -->
                                                    <TextBlock Text="{Binding Text, Mode=OneWay}"
                                                               FontSize="13"
                                                               Foreground="White"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="Wrap"
                                                               MaxHeight="60"
                                                               Margin="0,0,0,4">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="Text">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <!-- File variant -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="File">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <TextBlock Text="📄" FontSize="14"
                                                                   Foreground="#D0BCFF"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding FileName, Mode=OneWay}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="White"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Timestamp + source -->
                                                <TextBlock FontSize="11" Foreground="#9E9E9E">
                                                    <Run Text="{Binding ReceivedAtUtc, Mode=OneWay, StringFormat='HH:mm:ss'}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding SourceIp, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Action buttons -->
                                            <Button Grid.Column="1"
                                                    Content="Copy"
                                                    Command="{Binding DataContext.CopyToClipboardCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding ., Mode=OneWay}"
                                                    Background="#6750A4" Foreground="White"
                                                    BorderThickness="0"
                                                    FontSize="12" Padding="14,6"
                                                    Cursor="Hand"
                                                    VerticalAlignment="Center">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Text">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Content="Open folder"
                                                    Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding ., Mode=OneWay}"
                                                    Background="#6750A4" Foreground="White"
                                                    BorderThickness="0"
                                                    FontSize="12" Padding="14,6"
                                                    Cursor="Hand"
                                                    VerticalAlignment="Center">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="File">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty state -->
                    <StackPanel Grid.Row="0"
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasHistory}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="📤" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="No transfers yet"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="#9E9E9E"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="Send text or files from your phone, or send to your phone from the Send tab."
                                   FontSize="13" Foreground="#757575"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   MaxWidth="320" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Settings expander -->
                    <Expander Grid.Row="1"
                              Header="Settings"
                              IsExpanded="False"
                              Margin="0,16,0,0"
                              Background="#2A2A2A" Foreground="#D0BCFF"
                              BorderBrush="#3A3A3A" BorderThickness="1"
                              Padding="12,8">
                        <StackPanel Margin="12,8,0,8">
                            <CheckBox Content="Auto-copy received text to clipboard"
                                      IsChecked="{Binding AutoCopyToClipboard}"
                                      Foreground="White" FontSize="14"
                                      Cursor="Hand"/>
                            <TextBlock Text="When on, incoming text transfers are immediately copied to the clipboard."
                                       FontSize="11" Foreground="#9E9E9E"
                                       Margin="20,4,0,0" TextWrapping="Wrap"/>
                            <Button Content="Clear history"
                                    Command="{Binding ClearHistoryCommand}"
                                    Background="#B3261E" Foreground="White"
                                    BorderThickness="0"
                                    FontSize="12" Padding="14,6"
                                    Cursor="Hand"
                                    HorizontalAlignment="Left"
                                    Margin="0,12,0,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="IsEnabled" Value="True"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasHistory}" Value="False">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Expander>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
