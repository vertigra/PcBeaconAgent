<UserControl x:Class="PcBeaconAgent.Server.Tray.Views.FilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:coreModels="clr-namespace:PcBeaconAgent.Server.Core.Models;assembly=PcBeaconAgent.Server.Core"
             xmlns:trayModels="clr-namespace:PcBeaconAgent.Server.Tray.Models"
             xmlns:ext="clr-namespace:PcBeaconAgent.Server.Tray.Extensions"
             Background="#1E1E1E">
    <UserControl.Resources>
        <ext:InvertBoolConverter x:Key="InvertBoolConverter" />
    </UserControl.Resources>
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Send to phone ─────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="#2A2A2A"
                BorderBrush="#3A3A3A"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,10"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Send to Phone"
                           FontSize="14" FontWeight="Bold"
                           Foreground="#D0BCFF"
                           Margin="0,0,0,8"/>

                <!-- Device picker -->
                <ComboBox ItemsSource="{Binding ConnectedDevices, Mode=OneWay}"
                          SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          IsEnabled="{Binding IsSending, Converter={StaticResource InvertBoolConverter}}"
                          Margin="0,0,0,8"
                          MinWidth="200"/>

                <!-- No devices connected hint -->
                <TextBlock Text="No phones connected. Open the app on your phone to connect."
                           FontSize="11" Foreground="#757575"
                           Margin="0,0,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasConnectedDevices}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Text input -->
                <TextBox Text="{Binding OutgoingText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsSending, Converter={StaticResource InvertBoolConverter}}"
                         Height="60"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Background="#1E1E1E" Foreground="White"
                         BorderBrush="#3A3A3A"
                         Margin="0,0,0,8"
                         ToolTip="Type text to send to the selected phone"/>

                <!-- Action buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                    <Button Content="Send text"
                            Command="{Binding SendTextToPhoneCommand}"
                            Background="#6750A4" Foreground="White"
                            BorderThickness="0"
                            FontSize="12" Padding="14,6"
                            Cursor="Hand"
                            Margin="0,0,8,0"/>
                    <Button Content="📎 Send file"
                            Command="{Binding SendFileToPhoneCommand}"
                            IsEnabled="{Binding IsSending, Converter={StaticResource InvertBoolConverter}}"
                            Background="#424242" Foreground="White"
                            BorderThickness="0"
                            FontSize="12" Padding="14,6"
                            Cursor="Hand"/>
                </StackPanel>

                <!-- Send status (empty string renders nothing in WPF) -->
                <TextBlock Text="{Binding SendStatus}"
                           FontSize="11" Foreground="#9E9E9E"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── Transfer history ─────────────────────────────── -->
        <TextBlock Grid.Row="1"
                   Text="Transfer History"
                   FontSize="14" FontWeight="Bold"
                   Foreground="White"
                   Margin="0,0,0,8"/>

        <!-- History list (shown when there are items) -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasHistory}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <ItemsControl ItemsSource="{Binding History, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type coreModels:TransferRecord}">
                        <Border Background="#2A2A2A"
                                BorderBrush="#3A3A3A"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,0,0,8"
                                Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Content area: switches between text
                                     preview and file info based on Kind.
                                     The grid contains both variants and
                                     shows/hides them via DataTrigger. -->
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <Grid>
                                        <!-- Text variant -->
                                        <TextBlock Text="{Binding Text, Mode=OneWay}"
                                                   FontSize="13"
                                                   Foreground="White"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="60"
                                                   Margin="0,0,0,4">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Text">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- File variant: icon + name + size -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="File">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="📄"
                                                       FontSize="14"
                                                       Foreground="#D0BCFF"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding FileName, Mode=OneWay}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="White"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Timestamp + source IP (shared) -->
                                    <TextBlock FontSize="11" Foreground="#9E9E9E">
                                        <Run Text="{Binding ReceivedAtUtc, Mode=OneWay, StringFormat='HH:mm:ss'}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding SourceIp, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Action buttons: Copy (text only) and
                                     Open folder (file only). Both bound to
                                     the same record; the VM guards against
                                     the wrong kind. Visibility toggled via
                                     DataTrigger so only the relevant button
                                     is shown. -->
                                <Button Grid.Column="1"
                                        Content="Copy"
                                        Command="{Binding DataContext.CopyToClipboardCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding ., Mode=OneWay}"
                                        Background="#6750A4" Foreground="White"
                                        BorderThickness="0"
                                        FontSize="12"
                                        Padding="14,6"
                                        Cursor="Hand"
                                        VerticalAlignment="Center">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Text">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Grid.Column="1"
                                        Content="Open folder"
                                        Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding ., Mode=OneWay}"
                                        Background="#6750A4" Foreground="White"
                                        BorderThickness="0"
                                        FontSize="12"
                                        Padding="14,6"
                                        Cursor="Hand"
                                        VerticalAlignment="Center">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="File">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty state (shown when no items) -->
        <StackPanel Grid.Row="2"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasHistory}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="📤"
                       FontSize="48"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>
            <TextBlock Text="No transfers yet"
                       FontSize="18" FontWeight="Bold"
                       Foreground="#9E9E9E"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>
            <TextBlock Text="Send text from your phone using the send button on a managed device."
                       FontSize="13"
                       Foreground="#757575"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="320"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Settings -->
        <Expander Grid.Row="3"
                  Header="Settings"
                  IsExpanded="False"
                  Margin="0,16,0,0"
                  Background="#2A2A2A" Foreground="#D0BCFF"
                  BorderBrush="#3A3A3A" BorderThickness="1"
                  Padding="12,8">
            <StackPanel Margin="12,8,0,8">
                <CheckBox Content="Auto-copy received text to clipboard"
                          IsChecked="{Binding AutoCopyToClipboard}"
                          Foreground="White" FontSize="14"
                          Cursor="Hand"/>
                <TextBlock Text="When on, incoming text transfers are immediately copied to the clipboard. A toast confirms the copy. Turn off to only record in history."
                           FontSize="11" Foreground="#9E9E9E"
                           Margin="20,4,0,0" TextWrapping="Wrap"/>
                <Button Content="Clear history"
                        Command="{Binding ClearHistoryCommand}"
                        Background="#B3261E" Foreground="White"
                        BorderThickness="0"
                        FontSize="12"
                        Padding="14,6"
                        Cursor="Hand"
                        HorizontalAlignment="Left"
                        Margin="0,12,0,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="IsEnabled" Value="True"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasHistory}" Value="False">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Expander>
    </Grid>
</UserControl>
