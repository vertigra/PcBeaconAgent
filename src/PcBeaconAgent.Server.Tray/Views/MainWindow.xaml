<Window x:Class="PcBeaconAgent.Server.Tray.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PcBeaconAgent.Server.Tray.ViewModels"
        xmlns:views="clr-namespace:PcBeaconAgent.Server.Tray.Views"
        Title="PcBeaconAgent"
        Height="540" Width="480"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <Window.Resources>
        <!-- Header style: title + version, with the app icon on the left. -->
        <Style x:Key="HeaderTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#D0BCFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="HeaderVersion" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#9E9E9E"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Header: icon + app name + version ─────────────── -->
        <Border Grid.Row="0" Background="#2A2A2A" Padding="16,12">
            <DockPanel>
                <Image Source="pack://application:,,,/beacon.ico"
                       Width="32" Height="32"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>
                <TextBlock Style="{StaticResource HeaderTitle}"
                           Text="{Binding AppName}"
                           DockPanel.Dock="Left"/>
                <TextBlock Style="{StaticResource HeaderVersion}"
                           Text="{Binding AppVersion, StringFormat='  v{0}'}"
                           DockPanel.Dock="Left"/>
            </DockPanel>
        </Border>

        <!-- ── TabControl: Pairing / Settings / Files ────────── -->
        <TabControl Grid.Row="1" Background="#1E1E1E" BorderThickness="0,1,0,0" BorderBrush="#2C2C2C" Padding="0">
            <TabItem Header="Pairing"
                     Foreground="White" Background="#1E1E1E" BorderBrush="#3A3A3A">
                <views:PairingView DataContext="{Binding Pairing}"/>
            </TabItem>
            <TabItem Header="Settings"
                     Foreground="White" Background="#1E1E1E" BorderBrush="#3A3A3A">
                <views:SettingsView DataContext="{Binding Settings}"/>
            </TabItem>
            <TabItem Header="Files"
                     Foreground="White" Background="#1E1E1E" BorderBrush="#3A3A3A">
                <views:FilesView DataContext="{Binding Files}"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
