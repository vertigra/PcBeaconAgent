<Window x:Class="PcBeaconAgent.Server.Tray.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PcBeaconAgent.Server.Tray.ViewModels"
        xmlns:views="clr-namespace:PcBeaconAgent.Server.Tray.Views"
        Title="PcBeaconAgent"
        Height="540" Width="480"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <Window.Resources>
        <!-- Header style: title + version, with the app icon on the left. -->
        <Style x:Key="HeaderTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#D0BCFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="HeaderVersion" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#9E9E9E"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- TabItem style. The default WPF TabItem template paints the
             selected tab with the system highlight colour, which on a
             dark window makes the selected tab header invisible (white
             on white). We override the template's trigger-based colours
             so both selected and unselected tabs stay readable on the
             #1E1E1E background. -->
        <Style x:Key="DarkTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="#9E9E9E"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#2C2C2C"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#D0BCFF"/>
                                <Setter TargetName="Border" Property="Background" Value="#2A2A2A"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#3A3A3A"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="0,0,1,3"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#D0BCFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Header: icon + app name + version ─────────────── -->
        <Border Grid.Row="0" Background="#2A2A2A" Padding="16,12">
            <DockPanel>
                <Image Source="pack://application:,,,/beacon.ico"
                       Width="32" Height="32"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>
                <TextBlock Style="{StaticResource HeaderTitle}"
                           Text="{Binding AppName}"
                           DockPanel.Dock="Left"/>
                <TextBlock Style="{StaticResource HeaderVersion}"
                           Text="{Binding AppVersion, StringFormat='  v{0}'}"
                           DockPanel.Dock="Left"/>
            </DockPanel>
        </Border>

        <!-- ── TabControl: Pairing / Settings / Files ────────── -->
        <TabControl Grid.Row="1"
                    Background="#1E1E1E"
                    BorderThickness="0,1,0,0"
                    BorderBrush="#2C2C2C"
                    Padding="0">
            <TabItem Header="Pairing" Style="{StaticResource DarkTabItem}">
                <views:PairingView DataContext="{Binding Pairing}"/>
            </TabItem>
            <TabItem Header="Settings" Style="{StaticResource DarkTabItem}">
                <views:SettingsView DataContext="{Binding Settings}"/>
            </TabItem>
            <TabItem Header="Files" Style="{StaticResource DarkTabItem}">
                <views:FilesView DataContext="{Binding Files}"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
