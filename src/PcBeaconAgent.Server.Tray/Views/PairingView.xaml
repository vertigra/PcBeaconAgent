<UserControl x:Class="PcBeaconAgent.Server.Tray.Views.PairingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PcBeaconAgent.Server.Tray.ViewModels"
             Background="#1E1E1E">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Pairing PIN"
                   FontSize="13" Foreground="#9E9E9E"
                   Margin="0,0,0,8"/>

        <!-- Active PIN state -->
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="{Binding HasActivePin, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding CurrentPin}"
                       FontSize="42" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center"
                       FontFamily="Consolas"/>
            <TextBlock Text="Open the pairing page on your Android device to enter this code."
                       FontSize="11" Foreground="#757575"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap"
                       MaxWidth="300"/>
        </StackPanel>

        <!-- Empty state — no active PIN -->
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="{Binding HasNoActivePin, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock FontSize="28" Foreground="#9E9E9E"
                       HorizontalAlignment="Center"
                       FontFamily="Consolas"
                       Margin="0,0,0,16"
                       Text=" /\_/\
                             ( o.o )
                             &gt; ^ &lt;"/>
            <TextBlock Text="Waiting for a pairing request..."
                       FontSize="14" Foreground="#757575"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Open the PcBeaconAgent app on your Android device and navigate to the pairing page. The PIN will appear here automatically."
                       FontSize="11" Foreground="#555555"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       MaxWidth="320"/>
        </StackPanel>
    </Grid>
</UserControl>
