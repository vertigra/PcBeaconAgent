<UserControl x:Class="PcBeaconAgent.Server.Tray.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">

            <!-- ── Startup ───────────────────────────────────── -->
            <Expander Header="Startup"
                      IsExpanded="False"
                      Margin="0,0,0,12"
                      Background="#2A2A2A" Foreground="#D0BCFF"
                      BorderBrush="#3A3A3A" BorderThickness="1"
                      Padding="12,8">
                <StackPanel Margin="12,8,0,8">
                    <CheckBox Content="Start PcBeaconAgent when I log in"
                              IsChecked="{Binding AutoStartEnabled}"
                              IsEnabled="{Binding CanChangeAutoStart}"
                              Foreground="White" FontSize="14"
                              Cursor="Hand"/>
                    <TextBlock Text="Adds a registry entry under HKCU\…\Run. No admin rights needed."
                               FontSize="11" Foreground="#9E9E9E"
                               Margin="20,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Expander>

            <!-- ── Network (read-only) ───────────────────────── -->
            <!-- Editing host/ports requires a soft restart (Tier 3).
                 For now the values are displayed read-only so the user
                 can confirm what the server is bound to. -->
            <Expander Header="Network"
                      IsExpanded="False"
                      Margin="0,0,0,12"
                      Background="#2A2A2A" Foreground="#D0BCFF"
                      BorderBrush="#3A3A3A" BorderThickness="1"
                      Padding="12,8">
                <Grid Margin="12,8,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Host"
                               FontSize="12" Foreground="#9E9E9E"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding Host, Mode=OneWay}"
                               FontSize="13" Foreground="White"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="API port"
                               FontSize="12" Foreground="#9E9E9E"
                               VerticalAlignment="Center"
                               Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding ApiPort, Mode=OneWay}"
                               FontSize="13" Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,6,0,0"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Discovery port"
                               FontSize="12" Foreground="#9E9E9E"
                               VerticalAlignment="Center"
                               Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Text="{Binding DiscoveryPort, Mode=OneWay}"
                               FontSize="13" Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,6,0,0"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="To change these settings, edit appsettings.json and restart the application."
                               FontSize="11" Foreground="#757575"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"/>
                </Grid>
            </Expander>

            <!-- ── About ────────────────────────────────────── -->
            <Expander Header="About"
                      IsExpanded="False"
                      Margin="0,0,0,12"
                      Background="#2A2A2A" Foreground="#D0BCFF"
                      BorderBrush="#3A3A3A" BorderThickness="1"
                      Padding="12,8">
                <StackPanel Margin="12,8,0,8">
                    <TextBlock FontSize="14" Foreground="White" Margin="0,0,0,8">
                        <Run Text="{Binding AppName, Mode=OneWay}" FontWeight="Bold"/>
                        <Run Text="  "/>
                        <Run Text="{Binding AppVersion, Mode=OneWay}" Foreground="#9E9E9E"/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Open project page"
                                Command="{Binding OpenProjectUrlCommand}"
                                Padding="12,6"
                                Background="Transparent" Foreground="#D0BCFF"
                                BorderBrush="#3A3A3A" BorderThickness="1"
                                FontSize="12"
                                Cursor="Hand"/>
                        <Button Content="Check for updates"
                                Command="{Binding CheckForUpdatesCommand}"
                                Padding="12,6"
                                Background="Transparent" Foreground="#D0BCFF"
                                BorderBrush="#3A3A3A" BorderThickness="1"
                                FontSize="12"
                                Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- ── Logs ─────────────────────────────────────── -->
            <Expander Header="Logs"
                      IsExpanded="False"
                      Background="#2A2A2A" Foreground="#D0BCFF"
                      BorderBrush="#3A3A3A" BorderThickness="1"
                      Padding="12,8">
                <StackPanel Margin="12,8,0,8">
                    <TextBlock Text="{Binding LogFilePath, Mode=OneWay}"
                               FontSize="11" Foreground="#9E9E9E"
                               Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <Button Content="Open log folder"
                            Command="{Binding OpenLogFolderCommand}"
                            Padding="12,6"
                            Background="Transparent" Foreground="#D0BCFF"
                            BorderBrush="#3A3A3A" BorderThickness="1"
                            FontSize="12"
                            Cursor="Hand"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
