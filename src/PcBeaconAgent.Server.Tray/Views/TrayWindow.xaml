<Window x:Class="PcBeaconAgent.Server.Tray.Views.TrayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="TrayWindow"
        ShowInTaskbar="False"
        WindowStyle="None"
        Width="0" Height="0"
        Visibility="Hidden">
    <Grid>
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="pack://application:,,,/beacon.ico"
                        ToolTipText="PcBeaconAgent"
                        TrayLeftMouseUp="TrayIcon_TrayLeftMouseUp">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show PIN"
                              Command="{Binding ShowPinCommand}"/>
                    <MenuItem Header="Regenerate PIN"
                              Command="{Binding RegeneratePinCommand}"/>
                    <Separator/>
                    <MenuItem Header="Exit"
                              Command="{Binding ExitCommand}"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
