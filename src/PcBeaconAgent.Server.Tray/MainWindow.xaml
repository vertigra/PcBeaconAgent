<Window x:Class="PcBeaconAgent.Server.Tray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PcBeaconAgent"
        Height="300" Width="400"
        WindowStyle="None"
        ShowInTaskbar="False"
        Visibility="Hidden"
        ResizeMode="NoResize"
        Background="#1E1E1E">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="PcBeaconAgent"
                   FontSize="20" FontWeight="Bold" Foreground="#D0BCFF"
                   Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" Text="Pairing PIN"
                   FontSize="12" Foreground="#9E9E9E"
                   Margin="0,0,0,5"/>

        <TextBlock Grid.Row="2" x:Name="PinText"
                   FontSize="36" FontWeight="Bold" Foreground="White"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontFamily="Consolas"/>

        <Button Grid.Row="3" Content="Regenerate PIN"
                x:Name="RegenerateButton"
                Click="RegenerateButton_Click"
                Background="#6750A4" Foreground="White"
                Height="36" CornerRadius="8"
                Margin="0,10,0,0"/>
    </Grid>
</Window>
